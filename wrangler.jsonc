{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psych-factcheck",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
  ],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://iqqaglkueheksfyvwjpw.supabase.co",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZpYc_qkrhaap5d-QYUVT-g_rCWL17vq",
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "workflows": [
    {
      "name": "analysis-claim-extraction-v1",
      "binding": "ANALYSIS_WORKFLOW",
      "class_name": "AnalysisWorkflow",
    },
  ],
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
}
