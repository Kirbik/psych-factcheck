# Public Supabase values. These may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Trigger.dev: app server only; never expose the secret to the browser.
TRIGGER_PROJECT_REF=proj_your-project-ref
TRIGGER_SECRET_KEY=tr_dev_your-secret-key

# Set these independently in the Trigger.dev worker environment as well.
SUPABASE_URL=https://your-project.supabase.co
